{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganpans",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "ganpans.com/*", "zone_name": "ganpans.com" },
    { "pattern": "www.ganpans.com/*", "zone_name": "ganpans.com" }
  ]
}
